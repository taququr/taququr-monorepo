{
  "name": "@taququr/ui",
  "version": "0.2.0",
  "description": "Shared UI components for Taququr",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./*": "./dist/*.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts && npx shx cp src/theme.css dist/theme.css",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts && npx shx cp src/theme.css dist/theme.css",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@taququr/eslint-config": "*",
    "@taququr/typescript-config": "*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "shx": "^0.4.0",
    "tsup": "^9.0.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  }
}
