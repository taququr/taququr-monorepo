{
  "name": "taququr-monorepo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:portfolio-taququr": "turbo dev --filter=portfolio-taququr",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "typegen": "turbo run typegen --filter=portfolio-taququr"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
